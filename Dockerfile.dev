FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=burkeExport.settings_dev

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential default-libmysqlclient-dev pkg-config gettext \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# CSS: en tu máquina ejecuta `npm run watch:css` mientras desarrollas
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
