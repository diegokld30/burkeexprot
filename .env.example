# Copia este archivo a .env y completa los valores. NUNCA subas .env a git.
# Genera claves con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# (evita el carácter $ en los valores: docker compose lo interpreta)

# Seguridad
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=False
FORCE_HTTPS=True            # False solo para probar en local sin certificado

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=burkeexport.com,www.burkeexport.com

# Ruta privada del panel de administración (ej. gestion-a1b2c3d4/)
ADMIN_URL=cambia-esta-ruta/

# Sirve /media/ desde Django (pon False si nginx ya sirve /media/)
SERVE_MEDIA=True

# Puerto local donde escucha la app (nginx hace proxy a 127.0.0.1:WEB_PORT).
# Cámbialo si choca con otro servicio del servidor.
WEB_PORT=8001

# Base de datos MySQL/MariaDB
DATABASE_ENGINE=django.db.backends.mysql
DATABASE_NAME=burkeexport
DATABASE_USER=burkeuser
DATABASE_PASSWORD=cambia-esta-clave
DATABASE_HOST=db
DATABASE_PORT=3306
DB_ROOT_PASSWORD=cambia-esta-clave-root
